# Postgres (Neon via Vercel Marketplace in production)
DATABASE_URL="postgresql://makeloop:makeloop@localhost:55432/makeloop_app"
# Direct (non-pooled) connection used for migrations; the Neon integration sets this automatically
DATABASE_URL_UNPOOLED="postgresql://makeloop:makeloop@localhost:55432/makeloop_app"

# Long random string; signs session cookies
JWT_SECRET=""

# OpenAI-compatible chat/vision endpoint. Leave LLM_API_KEY empty to use the demo evaluator.
LLM_API_BASE="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL=""
VISION_MODEL=""

# Vercel Blob (auto-set when the Blob store is connected). Empty locally → images stored inline as data URLs.
BLOB_READ_WRITE_TOKEN=""

# "true" forces the deterministic demo evaluator (reliable stage demo)
DEMO_MODE="false"
